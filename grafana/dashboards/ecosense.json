  {
   "id": 9,
   "type": "timeseries",
   "title": "Mensagens por hora: leituras e eventos",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ecosense-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
