  {
   "id": 11,
   "type": "table",
   "title": "Interrupções não programadas (> 15 min)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ecosense-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ecosense-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT gap_start AS \"início\", gap_end AS \"fim\", round((gap_s/60)::numeric,1) AS \"minutos\" FROM gaps WHERE station_id = '$station' AND NOT coalesce(programmed,false) AND gap_s > 900 AND $__timeFilter(gap_end) ORDER BY gap_start DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Intervalos entre mensagens consecutivas que não correspondem a um par ENTRANDO_DEEP_SLEEP → ACORDOU_DEEP_SLEEP. É aqui que aparecem os desligamentos noturnos."
  },
