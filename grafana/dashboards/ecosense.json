      "uid": "ecosense-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT time_bucket('1 hour', observed_at) AS time, count(*) FILTER (WHERE kind='reading') AS leituras, count(*) FILTER (WHERE kind='event') AS eventos FROM readings WHERE station_id = '$station' AND $__timeFilter(observed_at) GROUP BY 1 ORDER BY 1"
