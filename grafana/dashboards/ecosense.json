{
 "uid": "ecosense-main",
 "title": "EcoSense Monitor",
 "timezone": "America/Fortaleza",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "Painel padrão do servidor aberto do EcoSense Monitor.",
 "templating": {
  "list": [
   {
    "name": "station",
    "label": "Estação",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "ecosense-pg"
    },
    "query": "SELECT station_id FROM stations ORDER BY 1",
    "refresh": 1,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Estado da estação",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ecosense-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ecosense-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT CASE\n  WHEN m.observed_at IS NULL THEN 'sem_dados'\n  WHEN m.event_key = 'ENTRANDO_DEEP_SLEEP'\n       AND now() - m.observed_at < make_interval(secs => coalesce(m.tempo_sleep_programado_s, 600) * 2 + 120)\n    THEN 'sono_programado'\n  WHEN now() - m.observed_at < interval '5 minutes' THEN 'online'\n  ELSE 'sem_comunicacao' END AS status\nFROM (SELECT 1) one LEFT JOIN LATERAL (SELECT * FROM readings WHERE station_id = '$station' ORDER BY observed_at DESC LIMIT 1) m ON TRUE"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "online": {
         "text": "Online",
         "color": "green",
         "index": 0
        },
        "sono_programado": {
         "text": "Sono programado",
         "color": "blue",
         "index": 1
        },
        "sem_comunicacao": {
         "text": "Sem comunicação",
         "color": "red",
         "index": 2
        },
        "sem_dados": {
         "text": "Sem dados",
         "color": "gray",
         "index": 3
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^status$/"
    }
   },
   "description": "Sono programado: a última mensagem foi ENTRANDO_DEEP_SLEEP e o tempo de sono ainda não estourou."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Última leitura há",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ecosense-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ecosense-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT extract(epoch FROM now() - max(observed_at))::float8 AS s FROM readings WHERE station_id = '$station' AND kind='reading'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Leituras nas últimas 24 h",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ecosense-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ecosense-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT count(*) AS leituras FROM readings WHERE station_id = '$station' AND kind='reading' AND observed_at > now() - interval '24 hours'"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   }
  },
  {
