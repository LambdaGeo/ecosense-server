# Copie para .env e troque todas as senhas.

# Domínio público da VM (Caddy obtém o certificado Let's Encrypt sozinho).
# Para testar localmente, use: DOMAIN=:80
DOMAIN=estacao.exemplo.ufma.br

POSTGRES_DB=ecosense
POSTGRES_USER=ecosense
POSTGRES_PASSWORD=troque-esta-senha
GRAFANA_DB_PASSWORD=troque-esta-tambem
GRAFANA_ADMIN_PASSWORD=troque-esta-tambem

# Fuso de timestamp_recebimento sem offset (relógio NTP do firmware, UTC−3).
# Confira com clock_skew_s após a importação: perto de ±10800 s = fuso errado.
DEVICE_TZ=America/Fortaleza
# Fuso de data_servidor sem offset recebido pela ponte (JSON do Apps Script).
SERVER_TZ=UTC

# Leitura da API sem chave. false = toda leitura exige X-API-Key
# (chaves criadas com: docker compose exec api python -m app.cli add-client ...)
PUBLIC_READ=true
# Painel Grafana visível sem login (somente visualização)
GRAFANA_ANONYMOUS=true

# Ponte de transição com o Apps Script atual (perfil "bridge")
APPSSCRIPT_URL=
BRIDGE_INTERVAL_S=60
